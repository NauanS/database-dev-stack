# Variáveis de Ambiente para Scripts de Backup PostgreSQL

# Discord Webhook URL para notificações de backup
# Obtenha em: Server Settings > Integrations > Webhooks > New Webhook
# Formato: https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WEBHOOK_URL_BKP=

# Configurações PostgreSQL
POSTGRES_USER=postgres
CONTAINER_NAME=postgres

# Google Drive (rclone)
GDRIVE_REMOTE=gdrive-backup
GDRIVE_PATH=bkps

# Retenção de backups (em dias)
# Arquivos mais antigos que RETENTION_DAYS serão deletados
RETENTION_DAYS=7

# Netlify (deploy automático do dashboard)
# Gere o token em: https://app.netlify.com/user/applications
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_SITE_URL=
