# ===================================
# GITIGNORE PARA AMBIENTE DE DESENVOLVIMENTO
# ===================================

# Arquivo de ambiente com senhas reais
.env
.env.local
.env.production
.env.staging

# Dados dos bancos de dados
data/
**/data/
volumes/

# Configurações (conf.d/redis.conf são versionadas); scripts de init podem ter dados sensíveis
configs/*/init/*
!configs/*/init/.gitkeep

# Logs
logs/
*.log
**/*.log

# Backups (em qualquer nível, ex.: databases/postgres/bkps)
backups/
**/bkps/*
!**/bkps/.gitkeep
!**/bkps/metrics
*.sql
*.sql.gz
*.dump
*.backup

# Métricas JSON (geradas automaticamente)
**/bkps/metrics/*
!**/bkps/metrics/.gitkeep

# Dashboard: só o template é versionado; o HTML gerado e a pasta publicada não
databases/postgres/dashboard.html
databases/postgres/public/

# Estado local do Netlify CLI (contém caminhos absolutos da máquina)
.netlify/

# Cópia aninhada acidental da pasta postgres
databases/postgres/postgres/

# Arquivos temporários
temp/
tmp/
.tmp/
*_OLD
*_NEW
*.backup.*
bkp/

# Arquivos do sistema
.DS_Store
Thumbs.db
.vscode/
.idea/

# Certificados e chaves
*.pem
*.key
*.crt
*.p12
certificates/

# Cache
.cache/
node_modules/
.npm/

# Arquivos de configuração local específicos
docker-compose.override.yml
docker-compose.local.yml

# Arquivos de monitoramento
monitoring/grafana/data/
monitoring/prometheus/data/

# Dados específicos dos bancos (apenas a pasta data/)
data/postgres/
data/mysql/
data/mariadb/
data/mongodb/
data/redis/
data/firebird/
redis-data/
firebird_data/

# Arquivos de estado do Rancher
rancher-data/

# Outros arquivos sensíveis
secrets/
.secrets/
.env.*
!.env.example
