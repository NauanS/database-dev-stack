# ===================================
# EXEMPLO DE CONFIGURAÇÕES DO AMBIENTE
# ===================================
# Copie este arquivo para .env e ajuste as configurações

# ===================================
# REDE
# ===================================
NETWORK_NAME=development_environment

# ===================================
# POSTGRESQL
# ===================================
POSTGRES_DB=dev_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# ===================================
# PGADMIN4 - Interface Web PostgreSQL
# ===================================
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=your_secure_password_here
PGADMIN_PORT=5050

# ===================================
# MYSQL
# ===================================
MYSQL_DATABASE=dev_database
MYSQL_USER=mysql_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_PORT=3306

# ===================================
# MARIADB
# ===================================
MARIADB_DATABASE=dev_database
MARIADB_USER=mariadb_user
MARIADB_PASSWORD=your_secure_password_here
MARIADB_ROOT_PASSWORD=your_secure_root_password_here
MARIADB_PORT=3307

# ===================================
# REDIS
# ===================================
REDIS_PASSWORD=your_secure_password_here
REDIS_PORT=6379

# ===================================
# REDISINSIGHT - Interface Web Redis
# ===================================
REDISINSIGHT_PORT=5540

# ===================================
# MONGODB
# ===================================
MONGODB_DATABASE=dev_database
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=your_secure_password_here
MONGODB_PORT=27017

# ===================================
# MONGO EXPRESS - Interface Web MongoDB
# ===================================
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=your_secure_password_here
MONGO_EXPRESS_PORT=8081

# ===================================
# FIREBIRD
# ===================================
FIREBIRD_PASSWORD=your_secure_password_here
FIREBIRD_PORT=3050

# ===================================
# ADMINER - Interface Web SQL
# ===================================
ADMINER_PORT=8080
